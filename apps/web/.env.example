# Haggle web app (apps/web). Copy to apps/web/.env.local and fill in. Never commit .env.local.
# Next.js reads this app's own .env.local, not the root .env. In production set these in the host
# (Vercel → Settings → Environment Variables) instead of a file.
# Check a filled file: npx tsx apps/web/scripts/check-env.ts --env-file apps/web/.env.local

# Where the Haggle MCP server runs, without /mcp (the Manufact dashboard URL in production).
HAGGLE_MCP_URL=http://localhost:3000
# Shared secret with the MCP server, at least 32 characters; the same value in apps/mcp/.env.
HAGGLE_SERVICE_TOKEN=

# Supabase Auth: the same project as the server's SUPABASE_URL (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# The anon (publishable) key; public by design.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: records workspace memberships, account export and deletion. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The chat (Claude).
ANTHROPIC_API_KEY=
# Default claude-opus-5-5.
WEB_CHAT_MODEL=
# Chat turns per UTC day across the whole site (empty or 0 = no cap).
WEB_CHAT_DAILY_CAP=

# Cloudflare Turnstile site key: bot check on sign-in (Supabase holds the secret key). Empty = no widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Support address shown in the footer and the legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Scheduler bearer secret for GET /api/cron/tick (16+ characters; Vercel Cron sends it).
CRON_SECRET=
# Forwarded to the MCP server's /internal/tick; the same value as HAGGLE_TICK_SECRET in apps/mcp/.env.
HAGGLE_TICK_SECRET=

# "true" only on a public demo against a mock-mode server (docs/demo-deploy.md). Never on a live site.
NEXT_PUBLIC_HAGGLE_DEMO=
# "standalone" when building the Docker image (apps/web/Dockerfile); unset on Vercel.
NEXT_OUTPUT=
