{
  "name": "haggle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:mcp": "npm run dev -w @haggle/mcp",
    "dev:sellers": "npm run dev -w @haggle/sellers",
    "test:pg": "scripts/test-postgres.sh",
    "verify:db": "scripts/verify-migrations.sh",
    "demo": "npm run demo -w @haggle/engine",
    "demo:server": "npm run build -w @haggle/mcp && cd apps/mcp && HAGGLE_MODE=mock HAGGLE_SIM_DELAY_SCALE=${HAGGLE_SIM_DELAY_SCALE:-0.5} npx mcp-use start --with-inspector",
    "verify": "npm run typecheck && npm test && npm run build && scripts/verify-migrations.sh && scripts/test-postgres.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
