{
  "name": "haggle",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:mcp": "npm run dev -w @haggle/mcp",
    "dev:sellers": "npm run dev -w @haggle/sellers"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
