# Haggle buyer side (apps/mcp). Copy to .env and fill in. Never commit .env.
# Leave HAGGLE_MODE=mock to run with no external services at all.

# mock | live. Mock mode never sends real email or moves money and is labelled everywhere.
HAGGLE_MODE=mock

# --- Inkbox (v5): the buyer identity's mailbox for every job ---
INKBOX_API_KEY=
# Agent handle of the buyer identity (its mailbox address is read from Inkbox, never derived).
INKBOX_IDENTITY=haggle
# Seller-reply trust. outbound-verified (default, strongest) needs a key that can read the seller's
# mailbox; with an agent-scoped buyer key use pinned-org-identity: a same-org Inkbox identity that
# is on HAGGLE_DEMO_FLEET/HAGGLE_ALLOWED_RECIPIENTS (recorded as "inkbox-org-identity").
INKBOX_SENDER_TRUST=outbound-verified
# The identity's webhook signing key (whsec_...); verifies X-Inkbox-Signature on POST /webhooks/inkbox.
INKBOX_WEBHOOK_SECRET=
# Voice AI calls stay OFF unless this is "true" (needs a human go-ahead; only simulated businesses
# or people who agreed may be called). Without its own number, the buyer calls from Inkbox's shared
# iMessage line (needs iMessage on the identity). Numbers must be on HAGGLE_ALLOWED_RECIPIENTS.
HAGGLE_ENABLE_CALLS=false
# A2A tasks to agent-ready businesses stay OFF unless "true". The Agent Card URL must be on
# HAGGLE_ALLOWED_RECIPIENTS, and the buyer's A2A contact rules must allow the seller's handle.
HAGGLE_ENABLE_A2A=false
# iMessage approval requests ("Reply YES <code>") to the settings approver stay OFF unless "true".
# The approver must first text `connect @haggle` to the Inkbox router number.
HAGGLE_ENABLE_IMESSAGE=false
# Calls a business places TO Haggle are matched by caller number; caller ID is spoofable, so their
# transcripts become quotes only if this is "true". Default: kept for audit, never a quote.
HAGGLE_TRUST_INBOUND_CALLER_ID=false
# Wait this many seconds before placing Voice AI RFQ calls, so the call can cite the best real
# competing quote (e.g. 60 for the demo). 0 = call at once.
HAGGLE_CALL_DELAY_S=0
# Call an email business that has an allowlisted phone if its email is unanswered this long (seconds).
# Empty = never escalate.
HAGGLE_ESCALATE_EMAIL_TO_CALL_S=
# Simulated seller fleet offered by discover: "Name <email>; Name <email>".
HAGGLE_DEMO_FLEET=
# Live mode contacts ONLY the fleet above plus these (comma-separated emails, @domains or E.164).
HAGGLE_ALLOWED_RECIPIENTS=
# Set to "true" only when contacting real businesses has been explicitly approved.
HAGGLE_ALLOW_ANY_RECIPIENT=false
# Operator ceiling for the settings spending cap, in cents (500000 = $5,000).
HAGGLE_SPENDING_CAP_CEILING_CENTS=500000

# --- Payments: Stripe TEST MODE, opt-in. Nothing is charged without a human approval of the exact quote. ---
# "true" enables Stripe test-mode deposits (needs the three STRIPE_* values below; a non-test key refuses to
# start). Anything else: every payment is refused and nothing is charged.
HAGGLE_ENABLE_PAYMENTS=false
# Per-payment ceiling in cents on top of each job's cap (the settings spending cap). Stripe default
# 50000 = $500 (max $10,000); the legacy x402 rail stays at most 1000 = $10.
HAGGLE_GLOBAL_PAYMENT_CAP_CENTS=50000

# --- Anthropic (quote extraction from text/PDF) ---
ANTHROPIC_API_KEY=
# Model for quote extraction.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required when the API key is not scoped to a workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# --- Supabase (server-side service role; never exposed to clients) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Dashboard > Connect). Use the session pooler (port 5432) or direct
# connection; the role must have BYPASSRLS because every table forces RLS with no policies.
SUPABASE_DB_URL=

# --- Stripe (TEST MODE ONLY) ---
# sk_test_... only. Customer + a card ATTACHED to it (run packages/engine/scripts/stripe-setup.ts <.env>
# --confirm once; a bare pm_card_visa test token is not attached and off-session charges would fail).
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=

# --- Brain (packages/brain) -------------------------------------------------
# Profiles go to Supabase when both are set; otherwise to HAGGLE_BRAIN_FILE.
# (uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above)
# HAGGLE_BRAIN_FILE=.haggle-data/brain.json
# HAGGLE_BRAIN_STORE=memory
# Real seller addresses written by `npm run setup -w @haggle/sellers`
# HAGGLE_DIRECTORY_FILE=.haggle-data/directory.json

# --- Seller fleet (apps/sellers) ---------------------------------------------
# Public base URL Inkbox posts seller webhooks to (default: https://$SELLERS_TUNNEL.inkboxwire.com)
# SELLERS_PUBLIC_URL=
# Inkbox tunnel name the seller server opens on start (an identity handle)
SELLERS_TUNNEL=bay-catering-sf
SELLERS_PORT=8787
# 1 = demo-speed replies (seconds instead of real business delays)
SELLERS_FAST=1
# Model for persona replies (default claude-opus-5-5); without an Anthropic key, templates are used
# SELLER_MODEL=
# A consenting person's phone (E.164) that plays Mission Eats instead of Voice AI (no Inkbox number needed)
# MISSION_EATS_PHONE=
# Voice for the Mission Eats phone persona
# MISSION_EATS_VOICE=ara
# Dev only: accept unsigned webhooks when no signing key is stored
# SELLERS_ALLOW_UNSIGNED=0
# The seller server (apps/sellers) reads INKBOX_API_KEY too: run it with the key of the org that owns the seller identities.
