# Haggle buyer side (apps/mcp). Copy to .env and fill in. Never commit .env.
# Leave HAGGLE_MODE=mock to run with no external services at all.

# mock | live. Mock mode never sends real email or moves money and is labelled everywhere.
HAGGLE_MODE=mock

# --- Workspaces (tenancy) ---
# "required": every MCP request needs a workspace credential (Authorization: Bearer <token>, or the
# connector URL /c/<secret>/mcp); create workspaces with `npm run workspace:create -w @haggle/mcp`.
# Anything else: open; requests without credentials use the default workspace. Use "required" on any
# hosted, multi-user server. Only the bare MCP handshake (initialize/ping) is ever unauthenticated.
HAGGLE_AUTH=open
# Shared secret (>= 16 chars) for POST /internal/tick (an external cron advancing every open deal).
# Empty = the route is disabled (the live server also ticks itself every 30 s).
HAGGLE_TICK_SECRET=

# --- Inkbox (v5): the buyer identity's mailbox for every job ---
INKBOX_API_KEY=
# Agent handle of the buyer identity (its mailbox address is read from Inkbox, never derived).
INKBOX_IDENTITY=haggle
# Seller-reply trust. outbound-verified (default, strongest) needs a key that can read the seller's
# mailbox; with an agent-scoped buyer key use pinned-org-identity: a same-org Inkbox identity that
# is on HAGGLE_DEMO_FLEET/HAGGLE_ALLOWED_RECIPIENTS (recorded as "inkbox-org-identity").
INKBOX_SENDER_TRUST=outbound-verified
# The identity's webhook signing key (whsec_...); verifies X-Inkbox-Signature on POST /webhooks/inkbox.
INKBOX_WEBHOOK_SECRET=
# Voice AI calls stay OFF unless this is "true" (needs a human go-ahead; only simulated businesses
# or people who agreed may be called). Without its own number, the buyer calls from Inkbox's shared
# iMessage line (needs iMessage on the identity). Numbers must be on HAGGLE_ALLOWED_RECIPIENTS.
HAGGLE_ENABLE_CALLS=false
# A2A tasks to agent-ready businesses stay OFF unless "true". The Agent Card URL must be on
# HAGGLE_ALLOWED_RECIPIENTS, and the buyer's A2A contact rules must allow the seller's handle.
HAGGLE_ENABLE_A2A=false
# iMessage approval requests ("Reply YES <code>") to the settings approver stay OFF unless "true".
# The approver must first text `connect @haggle` to the Inkbox router number.
HAGGLE_ENABLE_IMESSAGE=false
# SMS from the buyer identity's own number stays OFF unless "true" (the number must be SMS-ready).
# Texts HAGGLE_NOTIFY_PHONE on updates (new quote, a business question, a finished call, quotes
# ready); a reply to a question text is sent to the business as the answer. Also one follow-up text
# to an allowlisted phone business whose call ended without one clear total.
# With SMS on, approve also texts the human "Approve $250 deposit to ...? Reply YES 1234 or NO 1234";
# only a reply from that number with the code decides. Inkbox pauses texts to a number after 10
# with no reply: routine updates stop at 5 so questions/approvals still get through, and any reply
# (e.g. RESUME) resumes and re-sends what was missed.
HAGGLE_ENABLE_SMS=false
# E.164 number of the human who gets update texts (falls back to the settings approver).
HAGGLE_NOTIFY_PHONE=
# Who the AI assistant introduces itself as acting for, to businesses ("I'm an AI assistant reaching
# out on behalf of <name>"). A request detail "Customer: <name>" wins. Empty = "a customer".
HAGGLE_CUSTOMER_NAME=
# Approval by email (settings approver_email): Inkbox can't authenticate outside mail (e.g. Gmail),
# so a reply counts only from that exact address, in the approval thread, with "APPROVE <code>" /
# "NO <code>" (wrong codes lock after 5). Default on; "false" = only Inkbox-verified senders.
HAGGLE_EMAIL_APPROVAL_BY_CODE=true
# Calls a business places TO Haggle are matched by caller number; caller ID is spoofable, so their
# transcripts become quotes only if this is "true". Default: kept for audit, never a quote.
HAGGLE_TRUST_INBOUND_CALLER_ID=false
# Wait this many seconds before placing Voice AI RFQ calls, so the call can cite the best real
# competing quote (e.g. 60 for the demo). 0 = call at once.
HAGGLE_CALL_DELAY_S=0
# Call an email business that has an allowlisted phone if its email is unanswered this long (seconds).
# Empty = never escalate.
HAGGLE_ESCALATE_EMAIL_TO_CALL_S=
# With calls on: local hours "start-end" (in each workspace's timezone) when Haggle may place calls;
# calls outside them wait. Never two calls to one number within 2 minutes.
HAGGLE_CALL_HOURS=9-20
# With calls on: keep the Voice AI answering instructions in sync with open requests so a business
# calling back is matched to its request ("false" to leave the identity's instructions alone).
HAGGLE_SYNC_VOICE_CONTEXT=true
# Simulated seller fleet offered by discover: "Name <email>; Name <email>".
HAGGLE_DEMO_FLEET=
# The six predefined demo vendors' contact routes (JSON keyed by vendor; setting a contact authorizes it
# as a recipient). Keys: harbor_table, sunset_kitchen, mission_eats, bay_catering, golden_grill,
# quickquote_deli. Example: {"mission_eats":{"phone":"+14155550123"},"sunset_kitchen":{"phone":"+1…","channel":"imessage"}}
HAGGLE_DEMO_VENDORS=
# Live mode contacts ONLY the fleet above plus these (comma-separated emails, @domains or E.164).
HAGGLE_ALLOWED_RECIPIENTS=
# Set to "true" only when contacting real businesses has been explicitly approved.
HAGGLE_ALLOW_ANY_RECIPIENT=false
# Operator ceiling for the settings spending cap, in cents (500000 = $5,000).
HAGGLE_SPENDING_CAP_CEILING_CENTS=500000

# --- Payments: Stripe TEST MODE, opt-in. Nothing is charged without a human approval of the exact quote. ---
# "true" enables Stripe test-mode deposits (needs the three STRIPE_* values below; a non-test key refuses to
# start). Anything else: every payment is refused and nothing is charged.
HAGGLE_ENABLE_PAYMENTS=false
# Operator's per-payment safety ceiling in cents (500000 = $5,000; max 1000000 = $10,000). This is the
# only hard money limit on a payment; each deal's budget and the settings spending cap are shown to the
# human as caveats on the approval. Applies whether or not payments are on.
HAGGLE_GLOBAL_PAYMENT_CAP_CENTS=500000

# --- Anthropic (quote extraction from text/PDF/images/transcripts) ---
# Recommended. Without it (or when Claude fails) replies are read by a keyword fallback at low
# confidence, so their quotes are flagged low_confidence instead of being dropped.
ANTHROPIC_API_KEY=
# Model for quote extraction.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required when the API key is not scoped to a workspace (sent as anthropic-workspace-id).
ANTHROPIC_WORKSPACE_ID=

# --- Supabase (server-side service role; never exposed to clients) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Dashboard > Connect). Use the session pooler (port 5432) or direct
# connection; the role must have BYPASSRLS because every table forces RLS with no policies.
SUPABASE_DB_URL=
# Schema the engine migrations were applied to, when the database is shared with another app
# (default: public).
# HAGGLE_DB_SCHEMA=haggle
# Database pool size per server process (default 4, max 10). Supabase's session pooler caps
# clients per database (15) across every process and reload.
# HAGGLE_DB_POOL_MAX=4
# Inbound reconciliation (live): Inkbox delivers each webhook once, so the server also lists the
# buyer's mailbox, texts and calls and ingests replies whose webhook was lost, every
# HAGGLE_RECONCILE_EVERY_S (default 60) and before quotes are declared final. false: off.
# HAGGLE_RECONCILE=true
# HAGGLE_RECONCILE_EVERY_S=60

# --- Stripe (TEST MODE ONLY) ---
# sk_test_... only. Customer + a card ATTACHED to it (run packages/engine/scripts/stripe-setup.ts <.env>
# --confirm once; a bare pm_card_visa test token is not attached and off-session charges would fail).
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=

# --- Brain (packages/brain) -------------------------------------------------
# Profiles go to Supabase when both are set; otherwise to HAGGLE_BRAIN_FILE.
# (uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above)
# HAGGLE_BRAIN_FILE=.haggle-data/brain.json
# HAGGLE_BRAIN_STORE=memory
# Real seller addresses written by `npm run setup -w @haggle/sellers`
# HAGGLE_DIRECTORY_FILE=.haggle-data/directory.json

# --- Seller fleet (apps/sellers) ---------------------------------------------
# Public base URL Inkbox posts seller webhooks to (default: https://$SELLERS_TUNNEL.inkboxwire.com)
# SELLERS_PUBLIC_URL=
# Inkbox tunnel name the seller server opens on start (an identity handle)
SELLERS_TUNNEL=bay-catering-sf
SELLERS_PORT=8787
# 1 = demo-speed replies (seconds instead of real business delays)
SELLERS_FAST=1
# Model for persona replies (default claude-opus-5-5); without an Anthropic key, templates are used
# SELLER_MODEL=
# A consenting person's phone (E.164) that plays Mission Eats instead of Voice AI (no Inkbox number needed)
# MISSION_EATS_PHONE=
# Voice for the Mission Eats phone persona
# MISSION_EATS_VOICE=ara
# Dev only: accept unsigned webhooks when no signing key is stored
# SELLERS_ALLOW_UNSIGNED=0
# The seller server (apps/sellers) reads INKBOX_API_KEY too: run it with the key of the org that owns the seller identities.

# --- Public reputation (optional) ---
# Google Places API (New) key: real businesses on a deal get their public rating + review count
# (attributed, cached, non-blocking) as one best-value factor. Unset = reputation is neutral for all.
# Demo vendors are never looked up.
GOOGLE_PLACES_API_KEY=
# The same key also powers discover(category, area): real businesses from Google Places (found is not
# authorized; contacting one needs HAGGLE_ALLOWED_RECIPIENTS). Unset = discover says it's off.

# --- Build label (set by the deploy procedure) ---
# Shown in serverInfo and /health as 0.5.0+<sha>.
HAGGLE_BUILD_SHA=

# --- Mock-mode rehearsals only (never used in live mode) ---
# HAGGLE_SIM_DELAY_SCALE=0          # simulated vendors reply instantly (1 = realistic delays)
# HAGGLE_MOCK_VENDORS=none          # a server with no vendor set up (the "Setup needed" board)
# HAGGLE_MOCK_PERSONAS_FILE=apps/mcp/tests/fixtures/rehearsal-personas.json   # the 2026-10-18 rehearsal vendors
# HAGGLE_PLACES_FIXTURE=apps/mcp/tests/fixtures/places.json                    # recorded discovery (no key, no network)
# HAGGLE_MOCK_DATABASE_URL=         # a THROWAWAY Postgres to rehearse restarts (never the live database)
# HAGGLE_MOCK_BRAIN_FILE=           # keep simulated learning across restarts
