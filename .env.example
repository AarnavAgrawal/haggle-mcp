# Haggle buyer side (apps/mcp). Copy to .env and fill in. Never commit .env.
# Leave HAGGLE_MODE=mock to run with no external services at all.

# mock | live. Mock mode never sends real email or moves money and is labelled everywhere.
HAGGLE_MODE=mock

# --- Primitive (buyer org) ---
PRIMITIVE_API_KEY=
# Org webhook secret used verbatim (including any whsec_ prefix) to verify Primitive-Signature.
PRIMITIVE_WEBHOOK_SECRET=
# Expected webhook endpoint id (the org secret signs every endpoint; we also check delivery.endpoint_id).
PRIMITIVE_WEBHOOK_ENDPOINT_ID=
# Managed buyer domain, e.g. brave-otter.primitive.email. Job inboxes are job-<id>@<domain>.
HAGGLE_INBOX_DOMAIN=

# --- x402 payer (Base Sepolia testnet ONLY) ---
# Testnet-only private key for the buyer wallet. Server-side only; never sent to views.
HAGGLE_PAYER_PRIVATE_KEY=
# Hard per-payment ceiling in cents, applied on top of each job's own cap (500 = $5.00).
HAGGLE_GLOBAL_PAYMENT_CAP_CENTS=500

# --- Anthropic (quote extraction from text/PDF) ---
ANTHROPIC_API_KEY=

# --- Supabase (server-side service role; never exposed to clients) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
