# Copy to .env and fill in locally. Never commit .env.
# `mcp-use dev` and `npm run sim` load .env automatically.
# On Manufact Cloud, set the same values as server environment variables.

# Server
PUBLIC_BASE_URL=https://wild-cloud-utpra.run.mcp-use.com
MCP_AUTH_TOKEN=
INTERNAL_TICK_SECRET=
# Read-only demo page at /live?token=<value> (off when empty). Any long random string.
LIVE_PAGE_TOKEN=
DEMO_MODE=false

# Supabase (Project Settings > API). Service-role key stays server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public mode: anyone signs in (GitHub or an email link) instead of sharing
# MCP_AUTH_TOKEN; each user gets their own jobs, approvals (to their sign-in
# email), and Stripe test customer. See README "Public mode".
AUTH_MODE=token
# Publishable (anon) key: used only by the sign-in page in the browser.
SUPABASE_PUBLISHABLE_KEY=
LOGIN_METHODS=github,email
# The only restaurants public users may contact: "Name <email>; Name <email>".
DEMO_VENDORS=
JOBS_PER_USER_PER_DAY=10
# Run the restaurant simulators inside the server (then don't run npm run sim).
SIM_ON_SERVER=false

# Primitive
PRIMITIVE_API_KEY=
PRIMITIVE_FROM_ADDRESS=
PRIMITIVE_WEBHOOK_SECRET=
PRIMITIVE_ENDPOINT_ID=

# Anthropic
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-5-5
WRITER_MODEL=claude-sonnet-5-5

# Stripe (test mode only; the server refuses to start with a live key). Used from M4.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PAYMENT_METHOD_ID=
SPEND_CAP_CENTS=50000

# Approver (M4)
BUYER_EMAIL=

# Timing (seconds); DEMO_MODE=true overrides with 60 / 45 / 600
COLLECTION_WINDOW_SECONDS=1800
NEGOTIATION_WINDOW_SECONDS=900
APPROVAL_TTL_SECONDS=86400
MAX_ROUNDS_DEFAULT=1

# Restaurant simulators (npm run sim only; never needed on the server).
# `npm run setup:sim` creates one Primitive agent account per persona and
# fills these in for you.
SIM_BUDGET_BITES_API_KEY=
SIM_LE_PETIT_FOUR_API_KEY=
SIM_TAQUERIA_SOL_API_KEY=
SIM_GOLDEN_WOK_API_KEY=
SIM_MODEL=claude-haiku-5-5
SIM_DETERMINISTIC=false
SIM_DELAY_SCALE=1

# AX eval (npm run eval only)
QB_MCP_URL=https://wild-cloud-utpra.run.mcp-use.com/mcp
PRIMITIVE_MCP_URL=https://www.primitive.dev/mcp
EVAL_EXPECTED_BEST=Budget Bites
